# HaGoKu 环境变量配置
#
# 用法：复制到用户主目录（与代码约定一致）：
#   mkdir -p ~/.hagoku && cp .env.example ~/.hagoku/.env
# 然后编辑 ~/.hagoku/.env。勿在仓库根目录放 .env（不会被 config.py 加载）。

# LLM 配置（用户运行时通过 hagoku-ui 设置功能选择模型；这里仅占位默认值）
HAGOKYU_LLM_BASE_URL=  # 用户配置 LLM 服务地址（OpenAI 兼容协议）
HAGOKYU_LLM_API_KEY=none
HAGOKYU_LLM_MODEL=  # 用户配置

# 双层 LLM 策略（可选，不设则复用 HAGOKYU_LLM_MODEL）
# 注意：与「两套推理服务」不同——仍为同一 BASE_URL / API_KEY，仅模型名可分开指定。
# HAGOKYU_LLM_MODEL_DEEP=   # 深度推理模型（Analyst、仲裁器）
# HAGOKYU_LLM_MODEL_QUICK=  # 快速模型（Scout 字段语义、Reporter 叙述）

# Embedding 配置（向量知识库）
HAGOKYU_EMBEDDING_BASE_URL=
HAGOKYU_EMBEDDING_API_KEY=
HAGOKYU_EMBEDDING_MODEL=  # 用户配置

# 工作目录
HAGOKYU_WORK_DIR=~/.hagoku

# （可选）项目根目录：覆盖默认 ~/.hagoku/projects；设置后须重启 hagoku-api，且与 Web API 列项目/报告路径一致
# HAGOKYU_PROJECT_DIR=
